<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Intents</RootNamespace>
    <AssemblyName>Intent</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Intent</PackageId>
    <Version>0.3.0</Version>
    <Authors>Xia5dm9</Authors>
    <Description>Cold deferred-execution model for .NET: separate what to run from how to run it with a policy pipeline. Resilience (retry/timeout/CB) is in the Intent.Polly package.</Description>
    <PackageTags>async;await;intent;policies;pipeline;deferred</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Intent.Tests" />
    <InternalsVisibleTo Include="Intent.Polly" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Ship analyzers with the Intent package -->
  <ItemGroup>
    <ProjectReference Include="..\Intent.Analyzers\Intent.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackIntentAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_PackIntentAnalyzers" DependsOnTargets="Build">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\Intent.Analyzers\bin\$(Configuration)\netstandard2.0\Intent.Analyzers.dll"
                              PackagePath="analyzers/dotnet/cs"
                              Condition="Exists('$(MSBuildThisFileDirectory)..\Intent.Analyzers\bin\$(Configuration)\netstandard2.0\Intent.Analyzers.dll')" />
    </ItemGroup>
  </Target>

</Project>
